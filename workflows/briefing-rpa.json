      "webhookId": "164aacac-f4b3-4359-87e4-52a715a53f12",
      "parameters": {
        "httpMethod": "POST",
        "path": "rpa-briefing-demo",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "rpa-node-02"
    },
    {
      "name": "Contexto demo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        80
      ],
      "parameters": {
        "jsCode": "return [{json:{origem:'ficticia',modo:'demonstracao'}}];"
      },
      "id": "rpa-node-03"
    },
    {
      "name": "Analisar carteira em Python",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:8765/api/analise",
        "options": {
          "timeout": 10000
        }
      },
      "id": "rpa-node-04"
    },
    {
      "name": "Obter notícias sintéticas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        220
      ],
      "parameters": {
        "url": "http://127.0.0.1:8765/api/noticias",
        "options": {
          "timeout": 10000
        }
      },
      "id": "rpa-node-05"
    },
    {
      "name": "Unir análise e notícias",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        750,
        80
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "rpa-node-06"
    },
    {
      "name": "Validar contexto unido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        80
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nif (data.carteira?.origem !== 'ficticia' || data.noticias?.origem !== 'ficticia') throw new Error('Contexto incompleto ou fora da demonstracao');\nreturn [{json:{carteira:data.carteira,noticias:data.noticias}}];"
      },
      "id": "rpa-node-07"
    },
    {
      "name": "Gerar briefing e email local",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/api/briefing",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "rpa-node-08"
    },
    {
      "name": "Conferir resultado sem envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        80
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.status !== 'pronto_para_revisao' || r.enviado !== false || !r.arquivos?.email) throw new Error('Briefing nao confirmado');\nreturn [{json:{status:r.status,id:r.id,modo:r.modo,gerado_por:r.gerado_por,enviado:r.enviado,reutilizado:r.reutilizado,arquivos:r.arquivos,texto:r.texto}}];"
      },
      "id": "rpa-node-09"
    }
  ],
